{
  "description": "Example post-edit repository safety hook. Review and trust hooks before enabling them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,subprocess,sys; root=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); sys.exit(subprocess.call([sys.executable, str(root/'scripts'/'validation'/'safety_check.py'), '--quick'], cwd=root))\"",
            "async": true,
            "timeout": 30,
            "statusMessage": "Checking repository safety after file changes"
          }
        ]
      }
    ]
  }
}
