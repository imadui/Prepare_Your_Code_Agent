{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-3-7-sonnet-20250219",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews code diffs for security, performance, and architecture.",
      "mode": "subagent",
      "model": "anthropic/claude-3-7-sonnet-20250219",
      "prompt": "You are a senior code reviewer. You have read-only access. Review git diffs thoroughly and report concrete defects.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "provider": {
    "custom-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom OpenAI Gateway",
      "options": {
        "baseURL": "https://llm-gateway.example.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
