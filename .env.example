# ==============================================================================
# Model Provider Credentials (Example - Never commit actual keys or secrets!)
# ==============================================================================

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-sol

# Google Gemini API (AI Studio / Developer API)
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=your-model-name

# Google Vertex AI (Cloud Platform)
# Authenticate via: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=your-model-name

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=your-model-name

# Microsoft Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# OpenAI-Compatible Endpoint (vLLM, Ollama, LiteLLM, Groq, OpenRouter)
COMPATIBLE_BASE_URL=https://your-compatible-endpoint.example.com/v1
COMPATIBLE_API_KEY=your-endpoint-key-if-required
COMPATIBLE_MODEL=your-model-name
